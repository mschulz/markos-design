{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approver_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approver Id"
    },
    "dispatch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dispatch Id"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "intent_id": {
      "format": "uuid",
      "title": "Intent Id",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "awaiting",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "consumed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "domain",
    "approval_id",
    "intent_id",
    "intent_sha256",
    "revision",
    "status",
    "approver_id",
    "dispatch_id",
    "expires_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
