{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_kind": {
      "enum": [
        "human",
        "test-agent"
      ],
      "title": "Author Kind",
      "type": "string"
    },
    "body": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Body",
      "type": "string",
      "x-max-utf8-bytes": 16384
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "in_reply_to": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "In Reply To"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "domain",
    "conversation_id",
    "message_id",
    "sequence",
    "author_kind",
    "body",
    "created_at",
    "in_reply_to"
  ],
  "title": "Message",
  "type": "object"
}
