{
  "$defs": {
    "CallIntent": {
      "additionalProperties": false,
      "description": "Synthetic data only; digest does not replace authorization/atomic DB consumption.",
      "properties": {
        "agent_id": {
          "const": "control-test-agent",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_revision": {
          "minimum": 1,
          "title": "Agent Revision",
          "type": "integer"
        },
        "arguments": {
          "$ref": "#/$defs/FixtureArguments"
        },
        "arguments_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Arguments Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_class": {
          "const": "synthetic",
          "title": "Data Class",
          "type": "string"
        },
        "domain": {
          "enum": [
            "personal",
            "research",
            "work"
          ],
          "title": "Domain",
          "type": "string"
        },
        "effect": {
          "const": "read",
          "title": "Effect",
          "type": "string"
        },
        "epoch": {
          "format": "uuid",
          "title": "Epoch",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "grant_id": {
          "format": "uuid",
          "title": "Grant Id",
          "type": "string"
        },
        "grant_revision": {
          "minimum": 1,
          "title": "Grant Revision",
          "type": "integer"
        },
        "intent_id": {
          "format": "uuid",
          "title": "Intent Id",
          "type": "string"
        },
        "max_attempts": {
          "const": 1,
          "default": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "operation_key": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Operation Key",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "preview": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Preview",
          "type": "string"
        },
        "preview_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preview Sha256",
          "type": "string"
        },
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "recipient": {
          "const": "synthetic-mcp-fixture",
          "title": "Recipient",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "server_id": {
          "const": "synthetic-mcp-fixture",
          "title": "Server Id",
          "type": "string"
        },
        "task_fence": {
          "minimum": 1,
          "title": "Task Fence",
          "type": "integer"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "tool": {
          "const": "fixture.read",
          "title": "Tool",
          "type": "string"
        },
        "tool_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tool Schema Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "owner_id",
        "domain",
        "intent_id",
        "principal_id",
        "agent_id",
        "agent_revision",
        "task_id",
        "run_id",
        "epoch",
        "task_fence",
        "operation_key",
        "server_id",
        "tool",
        "tool_schema_sha256",
        "grant_id",
        "grant_revision",
        "policy_revision",
        "arguments",
        "arguments_sha256",
        "preview",
        "preview_sha256",
        "recipient",
        "data_class",
        "effect",
        "created_at",
        "expires_at"
      ],
      "title": "CallIntent",
      "type": "object"
    },
    "FixtureArguments": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "label"
      ],
      "title": "FixtureArguments",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public durable view; standing grants and automatic revocation have explicit semantics.",
  "properties": {
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approver_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approver Id"
    },
    "dispatch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dispatch Id"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "endpoint": {
      "title": "Endpoint",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent_id": {
      "format": "uuid",
      "title": "Intent Id",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "requires_human": {
      "title": "Requires Human",
      "type": "boolean"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "awaiting",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "consumed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "domain",
    "approval_id",
    "intent_id",
    "intent_sha256",
    "revision",
    "status",
    "approver_id",
    "dispatch_id",
    "requires_human",
    "expires_at",
    "intent",
    "endpoint"
  ],
  "title": "GovernedApproval",
  "type": "object"
}
