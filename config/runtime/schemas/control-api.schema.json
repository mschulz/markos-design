{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "M1-C remains execution-disabled.",
  "properties": {
    "api_origin": {
      "title": "Api Origin",
      "type": "string"
    },
    "chat_execution_enabled": {
      "const": false,
      "default": false,
      "title": "Chat Execution Enabled",
      "type": "boolean"
    },
    "environment": {
      "const": "test",
      "default": "test",
      "title": "Environment",
      "type": "string"
    },
    "identity_profile": {
      "const": "synthetic-pkce",
      "default": "synthetic-pkce",
      "title": "Identity Profile",
      "type": "string"
    },
    "real_accounts_enabled": {
      "const": false,
      "default": false,
      "title": "Real Accounts Enabled",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tool_execution_enabled": {
      "const": false,
      "default": false,
      "title": "Tool Execution Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "api_origin"
  ],
  "title": "SyntheticApiConfig",
  "type": "object"
}
