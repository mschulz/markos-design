{
  "$defs": {
    "NoopPayload": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "maxLength": 65536,
          "title": "Label",
          "type": "string"
        }
      },
      "title": "NoopPayload",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Opaque cloud-source identity; not a URL/path or an access grant.",
      "properties": {
        "domain": {
          "enum": [
            "personal",
            "research",
            "work"
          ],
          "title": "Domain",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "owner_id",
        "domain",
        "sha256"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "payload": {
          "type": "object"
        },
        "payload_ref": {
          "type": "null"
        }
      },
      "required": [
        "payload"
      ]
    },
    {
      "properties": {
        "payload": {
          "type": "null"
        },
        "payload_ref": {
          "type": "object"
        }
      },
      "required": [
        "payload_ref"
      ]
    }
  ],
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "foundation.noop.requested",
      "title": "Event Type",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "operation_key": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Operation Key",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoopPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "payload_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "source": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
      "title": "Source",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "owner_id",
    "domain",
    "source",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "sensitivity",
    "operation_key"
  ],
  "title": "EventEnvelope",
  "type": "object",
  "x-max-wire-bytes": 65536
}
