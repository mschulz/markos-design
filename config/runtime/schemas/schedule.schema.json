{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catch_up_limit": {
      "default": 10,
      "maximum": 100,
      "minimum": 1,
      "title": "Catch Up Limit",
      "type": "integer"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "fold": {
      "default": "first",
      "enum": [
        "first",
        "second"
      ],
      "title": "Fold",
      "type": "string"
    },
    "gap": {
      "const": "shift_forward",
      "default": "shift_forward",
      "title": "Gap",
      "type": "string"
    },
    "hour": {
      "anyOf": [
        {
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hour"
    },
    "interval_seconds": {
      "anyOf": [
        {
          "maximum": 2678400,
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval Seconds"
    },
    "kind": {
      "enum": [
        "interval",
        "daily"
      ],
      "title": "Kind",
      "type": "string"
    },
    "max_age_seconds": {
      "default": 86400,
      "maximum": 2592000,
      "minimum": 60,
      "title": "Max Age Seconds",
      "type": "integer"
    },
    "minute": {
      "anyOf": [
        {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minute"
    },
    "missed_policy": {
      "enum": [
        "catch_up",
        "coalesce",
        "skip"
      ],
      "title": "Missed Policy",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "run_grace_seconds": {
      "default": 5,
      "maximum": 59,
      "minimum": 0,
      "title": "Run Grace Seconds",
      "type": "integer"
    },
    "schedule_id": {
      "format": "uuid",
      "title": "Schedule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start_at": {
      "format": "date-time",
      "title": "Start At",
      "type": "string"
    },
    "timezone": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "schedule_id",
    "version",
    "owner_id",
    "domain",
    "kind",
    "start_at",
    "timezone",
    "missed_policy"
  ],
  "title": "ScheduleDefinition",
  "type": "object"
}
