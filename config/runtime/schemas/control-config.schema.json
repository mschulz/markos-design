  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "ES256",
      "default": "ES256",
      "title": "Algorithm",
      "type": "string"
    },
    "audience": {
      "const": "markos-control-test",
      "default": "markos-control-test",
      "title": "Audience",
      "type": "string"
    },
    "browser_cookie": {
      "const": "__Host-markos-session",
      "default": "__Host-markos-session",
      "title": "Browser Cookie",
      "type": "string"
    },
    "chat_execution_enabled": {
      "const": false,
      "default": false,
      "title": "Chat Execution Enabled",
      "type": "boolean"
    },
    "cookie_http_only": {
      "const": true,
      "default": true,
      "title": "Cookie Http Only",
      "type": "boolean"
    },
    "cookie_same_site": {
      "const": "lax",
      "default": "lax",
      "title": "Cookie Same Site",
      "type": "string"
    },
    "cookie_secure": {
      "const": true,
      "default": true,
      "title": "Cookie Secure",
      "type": "boolean"
    },
    "database_secret_ref": {
      "default": "MARKOS_RUNTIME_CONTROL_DATABASE_DSN",
      "pattern": "^MARKOS_RUNTIME_[A-Z][A-Z0-9_]{0,63}$",
      "title": "Database Secret Ref",
      "type": "string"
    },
    "environment": {
      "const": "test",
      "default": "test",
      "title": "Environment",
      "type": "string"
    },
    "gateway_enabled": {
      "const": false,
      "default": false,
      "title": "Gateway Enabled",
      "type": "boolean"
    },
    "issuer_id": {
      "const": "synthetic-issuer",
      "default": "synthetic-issuer",
      "title": "Issuer Id",
      "type": "string"
    },
    "issuer_url": {
      "default": "https://auth.markos.test",
      "title": "Issuer Url",
      "type": "string"
    },
    "jwks_cache_seconds": {
      "const": 60,
      "default": 60,
      "title": "Jwks Cache Seconds",
      "type": "integer"
    },
    "jwks_fetch_seconds": {
      "const": 5,
      "default": 5,
      "title": "Jwks Fetch Seconds",
      "type": "integer"
    },
    "jwks_file": {
      "default": "issuer-public.example.json",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}\\.json$",
      "title": "Jwks File",
      "type": "string"
    },
    "jwks_max_bytes": {
      "const": 65536,
      "default": 65536,
      "title": "Jwks Max Bytes",
      "type": "integer"
    },
    "jwks_refresh_min_seconds": {
      "const": 60,
      "default": 60,
      "title": "Jwks Refresh Min Seconds",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/ControlLimits"
    },
    "provider_session_cache_seconds": {
      "const": 15,
      "default": 15,
      "title": "Provider Session Cache Seconds",
      "type": "integer"
    },
    "real_accounts_enabled": {
      "const": false,
      "default": false,
      "title": "Real Accounts Enabled",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_secret_ref": {
      "default": "MARKOS_RUNTIME_CONTROL_SESSION_KEY",
      "pattern": "^MARKOS_RUNTIME_[A-Z][A-Z0-9_]{0,63}$",
      "title": "Session Secret Ref",
      "type": "string"
    },
    "token_type": {
      "const": "human-access",
      "default": "human-access",
      "title": "Token Type",
      "type": "string"
    },
    "tool_execution_enabled": {
      "const": false,
      "default": false,
      "title": "Tool Execution Enabled",
      "type": "boolean"
    }
