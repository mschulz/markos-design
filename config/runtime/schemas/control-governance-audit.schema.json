{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "format": "uuid",
      "title": "Audit Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "dispatch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dispatch Id"
    },
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "intent_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Intent Id"
    },
    "intent_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Intent Sha256"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "outcome": {
      "enum": [
        "requested",
        "denied",
        "awaiting",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "dispatched",
        "succeeded",
        "failed",
        "unknown",
        "reconciled",
        "cleanup"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "principal_id": {
      "format": "uuid",
      "title": "Principal Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "domain",
    "sequence",
    "audit_id",
    "principal_id",
    "correlation_id",
    "intent_id",
    "dispatch_id",
    "intent_sha256",
    "recorded_at",
    "outcome",
    "reason",
    "metadata"
  ],
  "title": "GovernanceAudit",
  "type": "object"
}
