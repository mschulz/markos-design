{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "enum": [
        "personal",
        "research",
        "work"
      ],
      "title": "Domain",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "principal_id": {
      "format": "uuid",
      "title": "Principal Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "roles": {
      "items": {
        "enum": [
          "viewer",
          "operator",
          "approver",
          "administrator"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "domain",
    "principal_id",
    "revision",
    "roles"
  ],
  "title": "Membership",
  "type": "object"
}
