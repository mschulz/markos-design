{
  "$defs": {
    "ResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "agent_slots": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Agent Slots",
          "type": "integer"
        },
        "app_memory_mib": {
          "default": 2048,
          "minimum": 128,
          "title": "App Memory Mib",
          "type": "integer"
        },
        "broker_cpus": {
          "default": 4,
          "maximum": 64,
          "minimum": 1,
          "title": "Broker Cpus",
          "type": "integer"
        },
        "broker_memory_mib": {
          "default": 4096,
          "minimum": 256,
          "title": "Broker Memory Mib",
          "type": "integer"
        },
        "close_timeout_seconds": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Close Timeout Seconds",
          "type": "integer"
        },
        "confirm_timeout_seconds": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Confirm Timeout Seconds",
          "type": "integer"
        },
        "connection_timeout_seconds": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Connection Timeout Seconds",
          "type": "integer"
        },
        "delivery_timeout_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Delivery Timeout Seconds",
          "type": "integer"
        },
        "disk_free_alarm_mib": {
          "default": 10240,
          "minimum": 1024,
          "title": "Disk Free Alarm Mib",
          "type": "integer"
        },
        "disk_free_warning_mib": {
          "default": 20480,
          "minimum": 1024,
          "title": "Disk Free Warning Mib",
          "type": "integer"
        },
        "handoff_timeout_seconds": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Handoff Timeout Seconds",
          "type": "integer"
        },
        "handoffs_per_process": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Handoffs Per Process",
          "type": "integer"
        },
        "heartbeat_seconds": {
          "default": 30,
          "minimum": 5,
          "title": "Heartbeat Seconds",
          "type": "integer"
        },
        "lock_timeout_seconds": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Lock Timeout Seconds",
          "type": "integer"
        },
        "max_channels_per_connection": {
          "default": 32,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Channels Per Connection",
          "type": "integer"
        },
        "max_connections": {
          "default": 32,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Connections",
          "type": "integer"
        },
        "max_inflight_confirms": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Inflight Confirms",
          "type": "integer"
        },
        "max_message_bytes": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Message Bytes",
          "type": "integer"
        },
        "max_queues": {
          "default": 64,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Queues",
          "type": "integer"
        },
        "memory_alarm_mib": {
          "default": 2048,
          "minimum": 128,
          "title": "Memory Alarm Mib",
          "type": "integer"
        },
        "os_memory_mib": {
          "default": 2048,
          "minimum": 256,
          "title": "Os Memory Mib",
          "type": "integer"
        },
        "prefetch": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Prefetch",
          "type": "integer"
        },
        "queue_max_bytes": {
          "default": 33554432,
          "maximum": 33554432,
          "minimum": 1,
          "title": "Queue Max Bytes",
          "type": "integer"
        },
        "queue_max_messages": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Queue Max Messages",
          "type": "integer"
        },
        "replay_batch_size": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Replay Batch Size",
          "type": "integer"
        },
        "replay_events_per_second": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "Replay Events Per Second",
          "type": "integer"
        },
        "statement_timeout_seconds": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Statement Timeout Seconds",
          "type": "integer"
        },
        "vm_cpus": {
          "default": 4,
          "maximum": 64,
          "minimum": 1,
          "title": "Vm Cpus",
          "type": "integer"
        },
        "vm_memory_mib": {
          "default": 8192,
          "minimum": 1024,
          "title": "Vm Memory Mib",
          "type": "integer"
        }
      },
      "title": "ResourceLimits",
      "type": "object"
    },
    "ServiceScope": {
      "additionalProperties": false,
      "description": "A trusted deployment identity, not authority supplied by an event.",
      "properties": {
        "domain": {
          "enum": [
            "personal",
            "research",
            "work"
          ],
          "title": "Domain",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "service_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "domain",
        "service_id"
      ],
      "title": "ServiceScope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "broker_dsn_env": {
      "default": "MARKOS_RUNTIME_BROKER_DSN",
      "pattern": "^MARKOS_RUNTIME_[A-Z][A-Z0-9_]{0,63}$",
      "title": "Broker Dsn Env",
      "type": "string"
    },
    "database_dsn_env": {
      "default": "MARKOS_RUNTIME_DATABASE_DSN",
      "pattern": "^MARKOS_RUNTIME_[A-Z][A-Z0-9_]{0,63}$",
      "title": "Database Dsn Env",
      "type": "string"
    },
    "dedup_retention_days": {
      "const": 90,
      "default": 90,
      "title": "Dedup Retention Days",
      "type": "integer"
    },
    "environment": {
      "enum": [
        "test",
        "development",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ResourceLimits"
    },
    "replay_window_days": {
      "const": 30,
      "default": 30,
      "title": "Replay Window Days",
      "type": "integer"
    },
    "role": {
      "enum": [
        "publisher",
        "consumer"
      ],
      "title": "Role",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ServiceScope"
    },
    "terminal_retention_days": {
      "const": 30,
      "default": 30,
      "title": "Terminal Retention Days",
      "type": "integer"
    },
    "topology_file": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Topology File",
      "type": "string"
    }
  },
  "required": [
    "environment",
    "role",
    "scope",
    "topology_file"
  ],
  "title": "RuntimeSettings",
  "type": "object"
}
